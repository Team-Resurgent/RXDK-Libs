{
  "name": "libuix",
  "triple": "msvc",
  "batches": [
    {
      "cpp": true,
      "outSubdir": "uix",
      "flags": [
        "-std=c++17",
        "-fno-exceptions",
        "-fno-rtti",
        "-nostdinc++",
        "-ffreestanding",
        "-fno-stack-protector",
        "-fdata-sections",
        "-ffunction-sections",
        "-nostdinc",
        "-fms-extensions",
        "-fms-compatibility",
        "-fasm-blocks",
        "-fno-operator-names",
        "-fno-sanitize=undefined",
        "-fno-builtin",
        "-mno-stack-arg-probe",
        "-fwrapv",
        "-Wno-everything",
        "-D_XAPI_",
        "-Xclang",
        "-fdefault-calling-conv=stdcall",
        "-include",
        "libs/libxonline/site/cdecl_libc.h",
        "-include",
        "picolibc.h",
        "-include",
        "libs/libxapi/site/profile.h",
        "-include",
        "libs/libxonline/site/bridge_xonline.h"
      ],
      "includeDirs": [
        "libs/libxonline/inc",
        "libs/libxonline/site",
        "libs/libxnet/net",
        "libs/libxnet/inc",
        "shared/include",
        "libs/libxapi/internal",
        "libs/libxapi/internal/shims",
        "libs/libxapi/k32",
        "libs/libxapi/k32/inc",
        "libs/libxapi/support/inc",
        "libs/libxapi/support/inc/ntos",
        "libs/libxapi/support/crypto",
        "libs/libxapi/support/fatx",
        "libs/libxapi/nt",
        "libs/libxapi/rtl/inc",
        "libs/libxapi/port",
        "libs/libxapi/site",
        "build/generated",
        "vendor/picolibc/libc/include",
        "vendor/picolibc/libc/machine/x86"
      ],
      "sources": [
        "libs/libxonline/src/uix.cpp",
        "libs/libxonline/src/uix_skin.cpp"
      ]
    }
  ]
}
