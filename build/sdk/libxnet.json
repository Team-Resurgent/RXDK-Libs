{
  "name": "libxnet",
  "triple": "msvc",
  "batches": [
    {
      "cpp": false,
      "outSubdir": "xnet/xnet-c",
      "flags": [
        "-std=c17",
        "-DXNET_BUILD_LIBX=1",
        "-ffreestanding",
        "-fno-stack-protector",
        "-fdata-sections",
        "-ffunction-sections",
        "-nostdinc",
        "-fms-extensions",
        "-fms-compatibility",
        "-fasm-blocks",
        "-fno-operator-names",
        "-fno-sanitize=undefined",
        "-fno-builtin",
        "-mno-stack-arg-probe",
        "-fwrapv",
        "-Wno-everything",
        "-D_XAPI_",
        "-Xclang",
        "-fdefault-calling-conv=stdcall",
        "-include",
        "libs/libxnet/site/cdecl_libc.h",
        "-include",
        "picolibc.h",
        "-include",
        "libs/libxapi/site/profile.h",
        "-include",
        "libs/libxnet/site/bridge_xnet.h"
      ],
      "includeDirs": [
        "libs/libxnet/net",
        "libs/libxnet/inc",
        "libs/libxnet/lib",
        "libs/libxnet/site",
        "shared/include",
        "libs/libxapi/internal",
        "libs/libxapi/internal/shims",
        "libs/libxapi/support/inc",
        "libs/libxapi/support/inc/ntos",
        "libs/libxapi/nt",
        "libs/libxapi/rtl/inc",
        "libs/libxapi/port",
        "libs/libxapi/site",
        "build/generated",
        "vendor/picolibc/libc/include",
        "vendor/picolibc/libc/machine/x86"
      ],
      "sources": [
        "libs/libxnet/lib/tcpipxsum.c"
      ]
    },
    {
      "cpp": true,
      "outSubdir": "xnet/xnet-cpp",
      "flags": [
        "-std=c++17",
        "-fno-exceptions",
        "-fno-rtti",
        "-nostdinc++",
        "-DXNET_BUILD_LIBX=1",
        "-ffreestanding",
        "-fno-stack-protector",
        "-fdata-sections",
        "-ffunction-sections",
        "-nostdinc",
        "-fms-extensions",
        "-fms-compatibility",
        "-fasm-blocks",
        "-fno-operator-names",
        "-fno-sanitize=undefined",
        "-fno-builtin",
        "-mno-stack-arg-probe",
        "-fwrapv",
        "-Wno-everything",
        "-D_XAPI_",
        "-Xclang",
        "-fdefault-calling-conv=stdcall",
        "-include",
        "libs/libxnet/site/cdecl_libc.h",
        "-include",
        "picolibc.h",
        "-include",
        "libs/libxapi/site/profile.h",
        "-include",
        "libs/libxnet/site/bridge_xnet.h"
      ],
      "includeDirs": [
        "libs/libxnet/net",
        "libs/libxnet/inc",
        "libs/libxnet/lib",
        "libs/libxnet/site",
        "shared/include",
        "libs/libxapi/internal",
        "libs/libxapi/internal/shims",
        "libs/libxapi/support/inc",
        "libs/libxapi/support/inc/ntos",
        "libs/libxapi/nt",
        "libs/libxapi/rtl/inc",
        "libs/libxapi/port",
        "libs/libxapi/site",
        "build/generated",
        "vendor/picolibc/libc/include",
        "vendor/picolibc/libc/machine/x86"
      ],
      "sources": [
        "libs/libxnet/net/base.cpp",
        "libs/libxnet/net/enet.cpp",
        "libs/libxnet/net/halw.cpp",
        "libs/libxnet/net/halx.cpp",
        "libs/libxnet/net/ip.cpp",
        "libs/libxnet/net/ipdhcp.cpp",
        "libs/libxnet/net/ipdns.cpp",
        "libs/libxnet/net/ipicmp.cpp",
        "libs/libxnet/net/ipqos.cpp",
        "libs/libxnet/net/nicw.cpp",
        "libs/libxnet/net/nicx.cpp",
        "libs/libxnet/net/sock.cpp",
        "libs/libxnet/net/socktcp.cpp",
        "libs/libxnet/net/sockudp.cpp",
        "libs/libxnet/net/xnet.cpp",
        "libs/libxnet/net/xnetp.cpp"
      ]
    }
  ]
}
